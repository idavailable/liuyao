{
  "name": "liuyao",
  "version": "2.0.0",
  "private": true,
  "description": "六爻排盘工具（生产零依赖，npm 仅用于测试层裁判库）",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node test-core.js && node test-rules.js",
    "test:fn": "node test-functions.mjs",
    "test:all": "npm test && npm run test:fn && npm run test:diff && npm run test:guji && npm run test:guji:self",
    "test:diff": "node test-diff.mjs",
    "test:guji": "node tests/guji/run.mjs",
    "test:guji:self": "node tests/guji/selftest.mjs",
    "test:ui": "node test-shake.js",
    "gen:jieqi": "node tools/gen-jieqi.js",
    "gen:guji": "node tools/guji-import.mjs",
    "gen:guji:bszz": "node tools/guji-import-bszz.mjs",
    "gen:guji:all": "npm run gen:guji && npm run gen:guji:bszz"
  },
  "devDependencies": {
    "@taoracle/najia": "^0.1.0",
    "iching-shifa": "^1.8.0",
    "lunar-javascript": "^1.7.3",
    "playwright-core": "^1.63.0"
  }
}
